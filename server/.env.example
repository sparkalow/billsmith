# Copy to .env and fill in. .env is gitignored — never commit a real token.

# Wrike permanent access token.
WRIKE_TOKEN=

# Wrike contact id whose timelogs are billed. Also stored in settings.wrike_contact_id.
WRIKE_CONTACT_ID=KUAUBLN4

# Override the SQLite file location. Defaults to <repo>/data/invoices.db
# DB_PATH=

# PORT=3000
# HOST=127.0.0.1
